{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "globals": {
      "type": "object",
      "metadata": { "description": "Global complex object passed to nested templates" }
    },
    "vmName": {
      "type": "string",
      "metadata": { "description": "The VM's name as shown in the portal - NOT the server's BIOS/hostname" }
    },
    "machineSettings": {
      "type": "object",
      "metadata": { "description": "Per-VM role settings (contains appID, basename, disks, etc.)" }
    }
  },
  "variables": {},
  "resources": [
    {
      "type": "Microsoft.Compute/virtualMachines/extensions",
      "apiVersion": "[parameters('globals').apiVersion.extension]",
      "name": "[concat(parameters('vmName'), '/SqlIaasExtension')]",
      "location": "[resourceGroup().location]",
      "properties": {
        "type": "SqlIaaSAgent",
        "publisher": "Microsoft.SqlServer.Management",
        "typeHandlerVersion": "2.0",
        "autoUpgradeMinorVersion": true,
        "settings": {
          "AutoPatchingSettings": {
            "Enable": true,
            "DayOfWeek": "Sunday",
            "MaintenanceWindowStartTime": "02:00",
            "MaintenanceWindowDuration": "60"
          },
          "TelemetryRegion": "[resourceGroup().location]",
          "KeyVaultCredentialSettings": {
            "Enable": true,
            "CredentialName": "[parameters('globals').sqlEncryption.sqlCredentialName]"
          }
        },
        "protectedSettings": {
          "PrivateKeyVaultCredentialSettings": {
            "AzureKeyVaultUrl": "[parameters('globals').sqlEncryption.keyVaultURL]",
            "ServicePrincipalName": "[parameters('globals').sqlEncryption.servicePrincipalName]",
            "ServicePrincipalSecret": "[parameters('globals').sqlEncryption.servicePrincipalSecret]",
            "ManagedIdentityClientId": ""
          }
        }
      }
    },

    {
      "condition": "[equals(parameters('machineSettings').appID, 'sql')]",
      "type": "Microsoft.Compute/virtualMachines/extensions",
      "apiVersion": "[parameters('globals').apiVersion.extension]",
      "name": "[concat(parameters('vmName'), '/SqlCollation')]",
      "location": "[resourceGroup().location]",
      "dependsOn": [
        "[resourceId('Microsoft.Compute/virtualMachines/extensions', parameters('vmName'), 'SqlIaasExtension')]"
      ],
      "properties": {
        "publisher": "Microsoft.Compute",
        "type": "CustomScriptExtension",
        "typeHandlerVersion": "1.10",
        "autoUpgradeMinorVersion": true,
        "settings": {
          "fileUris": [
            "[uri(deployment().properties.templateLink.uri, 'customScript/Set-SqlCollation.ps1')]"
          ]
        },
        "protectedSettings": {
          "commandToExecute": "[concat('powershell -ExecutionPolicy Bypass -File Set-SqlCollation.ps1 -SqlCollation \"', parameters('globals').sqlCollation, '\"')]"
        }
      }
    },

    {
      "condition": "[equals(parameters('machineSettings').appID, 'sql')]",
      "type": "Microsoft.SqlVirtualMachine/sqlVirtualMachines",
      "apiVersion": "[parameters('globals').apiVersion.sqlVirtualMachine]",
      "name": "[parameters('vmName')]",
      "location": "[resourceGroup().location]",
      "dependsOn": [
        "[resourceId('Microsoft.Compute/virtualMachines/extensions', parameters('vmName'), 'SqlIaasExtension')]",
        "[resourceId('Microsoft.Compute/virtualMachines/extensions', parameters('vmName'), 'SqlCollation')]"
      ],
      "properties": {
        "virtualMachineResourceId": "[resourceId('Microsoft.Compute/virtualMachines', parameters('vmName'))]",
        "sqlManagement": "Full",
        "sqlServerLicenseType": "[if(equals(parameters('globals').sqlBYOL, '-BYOL'), 'AHUB', 'PAYG')]",
        "serverConfigurationsManagementSettings": {
          "sqlConnectivityUpdateSettings": {
            "connectivityType": "PRIVATE",
            "port": 1433
          }
        }
      }
    }
  ]
}
